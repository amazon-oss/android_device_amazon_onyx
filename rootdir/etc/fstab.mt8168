# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                                <mnt_point>       <type> <mnt_flags and options>                                <fs_mgr_flags>
/dev/block/platform/soc/11230000.mmc/by-name/system   /system           ext4   ro                                                     wait,first_stage_mount
/dev/block/platform/soc/11230000.mmc/by-name/vendor   /vendor           ext4   ro                                                     wait,first_stage_mount
/dev/block/platform/soc/11230000.mmc/by-name/userdata /data             ext4   noatime,nosuid,nodev,noauto_da_alloc,errors=remount-ro wait,check,formattable,quota,reservedsize=128m,encryptable=/dev/block/platform/soc/11230000.mmc/by-name/metadata
/dev/block/platform/soc/11230000.mmc/by-name/cache    /cache            ext4   noatime,nosuid,nodev,noauto_da_alloc,discard           wait,check,formattable
/dev/block/platform/soc/11230000.mmc/by-name/nvcfg    /mnt/vendor/nvcfg ext4   noatime,nosuid,nodev,noauto_da_alloc,discard           wait,check,formattable

/dev/block/platform/soc/11230000.mmc/by-name/boot     /boot             emmc   defaults                                               defaults
/dev/block/platform/soc/11230000.mmc/by-name/recovery /recovery         emmc   defaults                                               defaults
/dev/block/platform/soc/11230000.mmc/by-name/misc     /misc             emmc   defaults                                               defaults

/devices/platform/soc/11240000.mmc*                   auto              vfat   defaults                                               voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/soc/11201000.usb*                   auto              vfat   defaults                                               voldmanaged=usbotg:auto
